# Copy this to backend/.env and fill in your values.
# Never commit .env to git.

# Database — SQLite locally, swap for postgresql+asyncpg://... on AWS
DATABASE_URL=sqlite+aiosqlite:///./routemaker.db

# JWT — generate a long random string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Strava OAuth — from https://www.strava.com/settings/api
STRAVA_CLIENT_ID=your_client_id
STRAVA_CLIENT_SECRET=your_client_secret
# The URL Strava redirects back to after auth (must match your Strava app settings)
STRAVA_REDIRECT_URI=http://localhost:8000/auth/strava/callback

# Frontend URL (used to redirect back to Angular after OAuth)
FRONTEND_URL=http://localhost:4200

# Optional: comma-separated Strava athlete IDs allowed to log in.
# Leave empty to allow anyone. Set during beta to restrict access.
ALLOWED_ATHLETE_IDS=

# Data directories
DATA_DIR=./data
